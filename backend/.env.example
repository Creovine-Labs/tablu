# ─── Supabase / Postgres (Phase 0) ───
# Supabase dashboard → Connect → ORMs (or Database → Connection string)
# DATABASE_URL = Transaction pooler (port 6543) — used by the app at runtime
DATABASE_URL="postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL = Direct connection (port 5432) — used only for Prisma migrations
DIRECT_URL="postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
# From Project Settings → API
SUPABASE_URL="https://[PROJECT].supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ─── Server ───
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# ─── Mux (Phase 2) ───
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""
MUX_WEBHOOK_SECRET=""

# ─── MTN MoMo Collections — sandbox (Phase 5) ───
# Rwanda portal: sandbox.momodeveloper.mtn.co.rw (default). Override only if needed.
MOMO_BASE_URL="https://sandbox.momodeveloper.mtn.co.rw"
MOMO_SUBSCRIPTION_KEY=""
MOMO_API_USER=""
MOMO_API_KEY=""
MOMO_TARGET_ENVIRONMENT="sandbox"
MOMO_CALLBACK_URL="http://localhost:4000/api/momo/callback"
# "true" = demo-safe simulated payments (always succeed). "false" = real MoMo calls.
MOMO_SIMULATE="true"
